---
const previewHeaders = [
  'CLIENTE',
  'CELULAR',
  'DIRECCION',
  'PRODUCTO',
  'PRECIO',
  'DISTRITO',
  'FECHA DE ENVIO',
  'OBSERVACION',
];
---

<div class="page-shell">
  <div class="toast-stack" id="toastStack" aria-live="polite" aria-atomic="true"></div>
  <div class="sr-only" id="srStatus" aria-live="polite"></div>

  <header class="topbar reveal reveal-delay-1">
    <div class="brand-row">
      <div class="brand-chip">
        <img src={`${import.meta.env.BASE_URL}assets/logo.png`} alt="Logo de Mercado Central Express" class="brand-logo" />
      </div>
      <div class="brand-copy">
        <h1>Mercado Central Express</h1>
        <p>ConVERTIR pedidos desde Excel a un PDF listo para imprimir</p>
      </div>
    </div>
  </header>

  <main class="workspace" data-card-app>
    <section class="sidebar-card reveal reveal-delay-2">
      <div class="section-head compact-head">
        <div>
          <span class="section-kicker">Carga</span>
          <h2>Sube el archivo</h2>
        </div>
        <p>Lectura local y exportacion inmediata.</p>
      </div>

      <label for="excelFile" class="upload-zone" id="uploadZone">
        <input type="file" id="excelFile" accept=".xlsx,.xls,.csv" hidden />
        <span class="upload-icon" aria-hidden="true">+</span>
        <strong>Subir archivo Excel</strong>
        <span>Haz clic o arrastra aqui</span>
      </label>

      <div class="actions compact-actions">
        <button id="actionBtn" class="btn btn-primary" disabled>Generar PDF</button>
      </div>

      <div class="mini-stats">
        <article class="mini-stat">
          <span>Pedidos</span>
          <strong id="orderCount">0</strong>
        </article>
        <article class="mini-stat">
          <span>Hojas</span>
          <strong id="sheetCount">0</strong>
        </article>
      </div>

      <div class="format-note">
        <span>Formato obligatorio</span>
        <code>CLIENTE | CELULAR | DIRECCION | PRODUCTO | PRECIO | DISTRITO | FECHA DE ENVIO | OBSERVACION</code>
      </div>
    </section>

    <section class="content-card reveal reveal-delay-3">
      <div class="section-head preview-head">
        <div>
          <span class="section-kicker">Vista previa</span>
          <h2>Pedidos cargados</h2>
        </div>
        <div class="preview-note">Lectura exacta por columnas</div>
      </div>

      <div class="table-wrapper">
        <table class="preview-table">
          <thead>
            <tr>
              {previewHeaders.map((header) => <th>{header}</th>)}
            </tr>
          </thead>
          <tbody id="previewBody">
            <tr class="empty-row">
              <td colspan={previewHeaders.length}>Aun no se han cargado pedidos.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </main>
</div>

<script>
  import '../scripts/card-generator.js';
</script>

